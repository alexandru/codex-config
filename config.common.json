{
  "approval_policy": "on-request",
  "approvals_reviewer": "auto_review",
  "default_permissions": "main",
  "web_search": "live",
  "tools": {
    "update_plan": {
      "enabled": true
    }
  },
  "features": {
    "multi_agent": true,
    "network_proxy": true,
    "daemon_auto_start": false,
    "context_management": {
      "experimental_mode": true
    }
  },
  "agents": {
    "enabled": true,
    "max_concurrent_threads_per_session": 4,
    "max_depth": 16,
    "interrupt_message": true
  },
  "permissions": {
    "main": {
      "extends": ":workspace",
      "network": {
        "enabled": true,
        "domains": {
          "*": "allow"
        }
      }
    }
  }
}
