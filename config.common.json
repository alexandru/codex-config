{
  "approval_policy": "on-request",
  "approvals_reviewer": "auto_review",
  "default_permissions": "main",
  "web_search": "live",
  "tools": {
    "update_plan": {
      "enabled": true
    }
  },
  "tui": {
    "status_line": [
      "model-with-reasoning",
      "current-dir",
      "thread-name",
      "context-used",
      "estimated-thread-cost"
    ]
  },
  "features": {
    "multi_agent": true,
    "network_proxy": true,
    "daemon_auto_start": false
  },
  "agents": {
    "enabled": true,
    "max_concurrent_threads_per_session": 4,
    "max_depth": 16,
    "interrupt_message": true
  },
  "permissions": {
    "main": {
      "extends": ":workspace",
      "filesystem": {
        "~/.agents/librarian": "write",
        "/tmp/codex": "write",
        "~/.agents/skills": "read"
      },
      "network": {
        "enabled": true,
        "domains": {
          "*": "allow"
        }
      }
    }
  }
}
